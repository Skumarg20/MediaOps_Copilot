
PROJECT_ENV=development
PORT=8080
APP_VERSION=1.0.0
LOG_LEVEL=info


DB_CLIENT=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=copilot
DB_PASSWORD=copilot
DB_DATABASE=mediaops
# Set to true only for managed Postgres that terminates TLS with its own CA.
DB_SSL=false

# --- Model runtime ---------------------------------------------------------
# hybrid     hosted generation (OpenRouter) + local embeddings. Default.
#            Skips ~3.9 GB of model downloads; falls back to local Ollama
#            generation if the hosted provider is unreachable.
# openrouter same, but with no local fallback.
# ollama     fully local, no keys, works offline. Needs all three models pulled.
#
# With LLM_PROVIDER=hybrid and no OPENROUTER_API_KEY set, the service logs a
# warning and uses Ollama rather than failing or silently degrading.
LLM_PROVIDER=hybrid

# --- OpenRouter (only when LLM_PROVIDER is hybrid or openrouter) ------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Logical arm name -> provider slug. The bandit keys arms by the LOGICAL name,
# so changing a slug here never orphans learned statistics. Verify these against
# https://openrouter.ai/models — a wrong slug shows up as a masked (unselectable)
# arm in /health, not as a runtime error.
OPENROUTER_MODEL_LLAMA=meta-llama/llama-3.2-3b-instruct
OPENROUTER_MODEL_QWEN=qwen/qwen-2.5-7b-instruct

# --- Ollama ----------------------------------------------------------------
# Still required for embeddings under `hybrid` (~270 MB):
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=30000
OLLAMA_EMBED_TIMEOUT_MS=15000
OLLAMA_PROBE_TTL_MS=10000
OLLAMA_CIRCUIT_THRESHOLD=3
OLLAMA_CIRCUIT_RESET_MS=30000
OLLAMA_MAX_RETRIES=1

# --- Retrieval -------------------------------------------------------------
RETRIEVAL_TOP_K=3
VECTOR_SIMILARITY_FLOOR=0.45
BM25_SCORE_FLOOR=1.2
BM25_COVERAGE_FLOOR=0.5
CHUNK_SIZE=500
CHUNK_OVERLAP=80
FORCE_VECTORLESS=false

# --- Agent -----------------------------------------------------------------
AGENT_MAX_STEPS=3

# --- Reinforcement learning ------------------------------------------------
RL_EPSILON_START=0.2
RL_EPSILON_FLOOR=0.05
RL_EPSILON_DECAY_PULLS=40
RL_OPTIMISTIC_INIT=5.0
RL_FEEDBACK_WEIGHT=10
RL_HALLUCINATION_PENALTY=5.0

# --- Grounding -------------------------------------------------------------
GROUNDING_HIGH_BAND=0.45
GROUNDING_MEDIUM_BAND=0.25

TEST_DB_DATABASE=mediaops_test
