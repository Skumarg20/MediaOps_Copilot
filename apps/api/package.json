{
  "name": "@mediaops/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node --env-file-if-exists=.env ../../node_modules/knex/bin/cli.js --knexfile knexfile.js migrate:latest",
    "migrate:rollback": "node --env-file-if-exists=.env ../../node_modules/knex/bin/cli.js --knexfile knexfile.js migrate:rollback",
    "migrate:make": "node --env-file-if-exists=.env ../../node_modules/knex/bin/cli.js --knexfile knexfile.js migrate:make",
    "ml:dataset": "tsx src/scripts/generateDataset.ts",
    "eval": "tsx --env-file-if-exists=.env src/eval/run.ts",
    "eval:architectures": "tsx src/eval/runArchitectures.ts",
    "graph:sync": "tsx src/scripts/syncGraph.ts",
    "graph:verify": "tsx src/scripts/verifyGraph.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/trpc-server": "^0.3.4",
    "@openrouter/ai-sdk-provider": "^0.7.5",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@trpc/server": "^11.0.0",
    "ai": "^4.3.19",
    "hono": "^4.6.13",
    "knex": "^3.1.0",
    "knex-stringcase": "^1.5.5",
    "neo4j-driver": "^6.2.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
